# Logs and runtime data only
logs/
*.log
.tmp-tauri-build.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data and processes
*.pid
*.pid.lock

# Node modules and build outputs
node_modules/
dist/
dist-ssr/
*.local

# Generated logo assets (source: docs/images/logo/)
public/logo.svg
public/logo-dark.svg
public/favicon.ico

# Environment variable files - never commit secrets
.env
.env.local
.env.*.local
.env.development
.env.production

# Rust/Tauri build artifacts
src-tauri/target/
src-tauri/gen/schemas/

# Release artifacts (generated by scripts)
release/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?

# Backup and temp files
*.backup
*.bak
*~
*.tmp
*.temp
tmp/*

# phpMyAdmin runtime files (keep the staged source)
phpmyadmin/tmp/
phpmyadmin/upload/
phpmyadmin/save/
phpmyadmin/config.secret.inc.php

# Staged phpMyAdmin runtime copy and staging scratch dirs
/packaging/phpmyadmin-runtime/
/packaging/phpmyadmin-report.json
/packaging/.phpmyadmin-stage-*/
/packaging/.phpmyadmin-previous-*/

# Application runtime data
www/tmp/
www/cache/
www/uploads/
www/storage/
www/*/cache/
www/*/logs/
www/*/storage/logs/
www/*/storage/framework/cache/
www/*/storage/framework/sessions/
www/*/storage/framework/views/

# WordPress specific runtime
www/*/wp-content/uploads/
www/*/wp-content/cache/
www/*/wp-config.php

# Laravel specific runtime
www/*/.env
www/*/storage/logs/
www/*/bootstrap/cache/

# Local app review screenshots (may contain local paths)
/review-artifacts/
src-tauri/tauri.local-test.conf.json
