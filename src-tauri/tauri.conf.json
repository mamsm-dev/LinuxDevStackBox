{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinuxDevStackBox",
  "version": "0.1.22",
  "identifier": "com.mam.linuxdevstackbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LinuxDevStackBox",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "deb",
      "rpm"
    ],
    "publisher": "MAM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../packaging/phpmyadmin-runtime": "phpmyadmin"
    },
    "externalBin": [],
    "copyright": "© 2026 MAM",
    "category": "Development",
    "shortDescription": "Local PHP development environment for Linux",
    "longDescription": "LinuxDevStackBox is a local PHP development environment for Linux: it manages Apache, MySQL/MariaDB, PHP and phpMyAdmin from distribution packages with per-user configuration, virtual hosts, trusted local HTTPS, database tooling and an integrated terminal.",
    "linux": {
      "deb": {
        "depends": [
          "apache2",
          "mariadb-server",
          "php",
          "php-cgi",
          "libnss3-tools",
          "openssl",
          "policykit-1"
        ]
      },
      "rpm": {
        "depends": [
          "httpd",
          "mariadb-server",
          "php",
          "php-cgi",
          "openssl",
          "polkit"
        ]
      }
    }
  }
}
