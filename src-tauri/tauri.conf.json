{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinuxDevStackBox",
  "version": "0.2.1",
  "identifier": "com.srapsware.linuxdevstackbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LinuxDevStackBox",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "publisher": "Nomad Programmer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../packaging/phpmyadmin-runtime": "phpmyadmin",
      "../www": "www"
    },
    "externalBin": [],
    "copyright": "© 2026 Nomad Programmer",
    "category": "DeveloperTool",
    "shortDescription": "Local PHP development environment for Linux",
    "longDescription": "Apache, MySQL/MariaDB, phpMyAdmin and PHP 8.2-8.5 manager for Linux. Linux port of DevStackBox.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "devel",
        "depends": [
          "apache2",
          "mariadb-server | mysql-server",
          "php-cgi",
          "php-cli",
          "php-mysql",
          "policykit-1 | polkitd",
          "xdg-utils"
        ],
        "recommends": [
          "libnss3-tools",
          "openssl"
        ]
      },
      "rpm": {
        "depends": [
          "httpd",
          "mariadb-server",
          "php-cgi",
          "php-cli",
          "php-mysqlnd",
          "polkit",
          "xdg-utils"
        ],
        "recommends": [
          "nss-tools",
          "openssl"
        ]
      }
    },
    "license": "MIT",
    "homepage": "https://github.com/mamsm-dev/LinuxDevStackBox"
  }
}
