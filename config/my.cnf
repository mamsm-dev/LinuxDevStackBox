# Template for LinuxDevStackBox. The real file is generated at runtime in
# ~/.local/share/linuxdevstackbox/config/my.cnf (see create_default_mysql_config);
# @DATADIR@, @TMPDIR@ and @LOGDIR@ are filled in by the app.
[mysqld]
port=3306
datadir=@DATADIR@
socket=@TMPDIR@/mysql.sock
pid-file=@TMPDIR@/mysqld.pid
default-storage-engine=InnoDB
sql-mode="STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO"
max_connections=100
table_open_cache=2000
tmp_table_size=16M
thread_cache_size=10
key_buffer_size=8M
sort_buffer_size=256K
bind-address=127.0.0.1
loose-mysqlx=0
log-error=@LOGDIR@/mysql.log

[mysql]
default-character-set=utf8mb4

[client]
host=127.0.0.1
protocol=TCP
port=3306
default-character-set=utf8mb4
